# ---------- Google (Gmail API e, opcionalmente, Sheets) ----------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (tipo "Desktop app")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gerado por `npm run auth:gmail`
GOOGLE_REFRESH_TOKEN=
# GOOGLE_REDIRECT_URI=http://localhost:53682/oauth2callback

# Filtro do Gmail (opcional). Padrão: remetentes dos principais bancos brasileiros.
# GMAIL_QUERY=from:(nubank.com.br OR itau.com.br OR c6bank.com.br) subject:(compra OR pix OR fatura)
GMAIL_LOOKBACK_DAYS=7
GMAIL_MAX_MESSAGES=50
GMAIL_PROCESSED_LABEL=gastos-sync/processado

# ---------- Gemini ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------- Armazenamento: "supabase" ou "sheets" ----------
STORAGE_BACKEND=supabase

# Supabase > Project Settings > API (use a service_role key; nunca exponha no frontend)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets (se STORAGE_BACKEND=sheets): ID da URL da planilha
# GOOGLE_SHEETS_ID=
# GOOGLE_SHEETS_TAB=transacoes

# ---------- Resumo / projeção ----------
SALDO_INICIAL=0
MESES_HISTORICO_VARIAVEL=3
PORT=3000
